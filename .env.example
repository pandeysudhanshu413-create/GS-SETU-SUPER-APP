# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GS Setu Notifications & Business Settings
# Configured business email for order alerts (Defaults to founder's email: pandeysudhanshu413@gmail.com)
BUSINESS_EMAIL="pandeysudhanshu413@gmail.com"

# Gmail SMTP for Live Order Emails:
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

